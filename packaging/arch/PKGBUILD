# Maintainer: krotrn <krotrn.ks@gmail.com>
pkgname=unpakt
pkgver=0.1.2
pkgrel=1
pkgdesc="Install, update and roll back AppImages and tarballs per user"
arch=('x86_64')
url="https://github.com/krotrn/unpakt"
license=('MIT OR Apache-2.0')
depends=('gtk4' 'libadwaita' 'glibc' 'gcc-libs')
optdepends=('fuse2: run AppImages without extracting them')
makedepends=('cargo')
options=('!lto' '!debug')
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
# CI (packaging/arch/ci-build.sh release) pins the real sum for each tag.
sha256sums=('SKIP')

prepare() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --release --frozen -p unpakt-cli -p unpakt-gui
}

check() {
  cd "$pkgname-$pkgver"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen -p unpakt-core -p unpakt-cli
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 target/release/unpakt target/release/unpakt-gui -t "$pkgdir/usr/bin/"
  install -Dm644 data/io.github.krotrn.Unpakt.desktop -t "$pkgdir/usr/share/applications/"
  install -Dm644 data/io.github.krotrn.Unpakt.metainfo.xml -t "$pkgdir/usr/share/metainfo/"
  install -Dm644 data/icons/hicolor/scalable/apps/io.github.krotrn.Unpakt.svg -t "$pkgdir/usr/share/icons/hicolor/scalable/apps/"
  install -Dm644 LICENSE-MIT LICENSE-APACHE -t "$pkgdir/usr/share/licenses/$pkgname/"
  target/release/unpakt completion bash | install -Dm644 /dev/stdin "$pkgdir/usr/share/bash-completion/completions/unpakt"
  target/release/unpakt completion zsh | install -Dm644 /dev/stdin "$pkgdir/usr/share/zsh/site-functions/_unpakt"
  target/release/unpakt completion fish | install -Dm644 /dev/stdin "$pkgdir/usr/share/fish/vendor_completions.d/unpakt.fish"
}
